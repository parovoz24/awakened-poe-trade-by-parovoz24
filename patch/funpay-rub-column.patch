@@ -0,0 +1,58 @@
+<template>
+  <template v-if="funpay.showColumn.value">
+    <td class="px-2 whitespace-nowrap text-right" :class="{ 'cursor-pointer': list != null }"
+      @click="copy(list, 'list')">
+      <span v-if="copied === 'list'" class="text-green-500"><i class="fas fa-check"></i></span>
+      <template v-else>{{ funpay.format(list) }}</template>
+    </td>
+    <td v-if="funpay.showNet.value" class="px-2 whitespace-nowrap text-right text-gray-400"
+      :class="{ 'cursor-pointer': net != null }"
+      @click="copy(net, 'net')">
+      <span v-if="copied === 'net'" class="text-green-500"><i class="fas fa-check"></i></span>
+      <template v-else>{{ funpay.format(net) }}</template>
+    </td>
+  </template>
+</template>
+
+<script lang="ts">
+import { defineComponent, computed, shallowRef } from 'vue'
+import { useFunPay } from '@/web/background/FunPay'
+
+export default defineComponent({
+  props: {
+    amount: {
+      type: Number,
+      required: true
+    },
+    currency: {
+      type: String,
+      required: true
+    }
+  },
+  setup (props) {
+    const funpay = useFunPay()
+    const copied = shallowRef<'list' | 'net' | null>(null)
+    let timer: ReturnType<typeof setTimeout> | undefined
+
+    async function copy (value: number | undefined, which: 'list' | 'net') {
+      if (value == null) return
+      try {
+        await navigator.clipboard.writeText(funpay.clipboardText(value))
+        copied.value = which
+        if (timer) clearTimeout(timer)
+        timer = setTimeout(() => { copied.value = null }, 1000)
+      } catch (e) {
+        console.warn('[funpay] copy failed', e)
+      }
+    }
+
+    return {
+      funpay,
+      copied,
+      copy,
+      list: computed(() => funpay.listPrice(props.amount, props.currency)),
+      net: computed(() => funpay.netPrice(props.amount, props.currency))
+    }
+  }
+})
+</script>

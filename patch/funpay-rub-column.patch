diff --git a/renderer/src/web/background/FunPay.ts b/renderer/src/web/background/FunPay.ts
new file mode 100644
index 0000000..82a1c06
--- /dev/null
+++ b/renderer/src/web/background/FunPay.ts
@@ -0,0 +1,406 @@
+import { shallowRef, readonly, watch, computed } from 'vue'
+import { createGlobalState } from '@vueuse/core'
+import { Host } from '@/web/background/IPC'
+import { AppConfig } from '@/web/Config'
+import { useLeagues } from './Leagues'
+import { usePoeninja } from './Prices'
+import type { PriceCheckWidget } from '@/web/overlay/interfaces'
+
+// FunPay "chips" pages for Path of Exile
+const DIVINE_PAGE = 'funpay.com/chips/173/'
+const CHAOS_PAGE = 'funpay.com/chips/76/'
+export const FUNPAY_DIVINE_URL = 'https://funpay.com/chips/173/'
+
+const UPDATE_INTERVAL_MS = 30 * 60 * 1000
+const RETRY_INTERVAL_MS = 4 * 60 * 1000
+const INTEREST_SPAN_MS = 20 * 60 * 1000
+
+// how many cheapest lots are used to calculate the rate (median)
+const CHEAPEST_LOTS = 5
+const MIN_ONLINE_LOTS = 3
+
+interface FunPayLot {
+  serverId: string
+  price: number
+  amount: number
+  online: boolean
+}
+
+interface FunPayPage {
+  unit: string
+  servers: Array<{ id: string, name: string }>
+  lots: FunPayLot[]
+  csrfToken: string | undefined
+}
+
+export interface FunPayRates {
+  /** price of 1 Divine Orb */
+  divine: number | undefined
+  /** price of 1 Chaos Orb from the FunPay chaos page (fallback only) */
+  chaos: number | undefined
+  /** currency symbol shown by FunPay (normally ₽) */
+  unit: string
+  /** FunPay league (server) name, e.g. "(PC) Curse of the Allflame" */
+  server: string
+  updatedAt: number
+}
+
+export const useFunPay = createGlobalState(() => {
+  const leagues = useLeagues()
+  const { xchgRate, findPriceByQuery } = usePoeninja()
+
+  const rates = shallowRef<FunPayRates | null>(null)
+  const error = shallowRef<string | null>(null)
+  const isLoading = shallowRef(false)
+  /** PC leagues available on FunPay (names as shown on the site) */
+  const servers = shallowRef<string[]>([])
+  const serversLoading = shallowRef(false)
+
+  let lastUpdateTime = 0
+  let lastInterestTime = 0
+  let lastAttemptTime = 0
+  let currencySwitchTried = false
+
+  const widget = computed(() => AppConfig<PriceCheckWidget>('price-check'))
+  const enabled = computed(() => widget.value?.showFunpayRub !== false)
+
+  async function load (force = false) {
+    if (!enabled.value) return
+    const league = leagues.selected.value
+    if (!league || league.realm !== 'pc-ggg') return
+    if (isLoading.value) return
+
+    if (!force && (
+      (Date.now() - lastUpdateTime) < UPDATE_INTERVAL_MS ||
+      (Date.now() - lastInterestTime) > INTEREST_SPAN_MS ||
+      (Date.now() - lastAttemptTime) < RETRY_INTERVAL_MS
+    )) return
+
+    lastAttemptTime = Date.now()
+    isLoading.value = true
+    try {
+      let divPage = await fetchPage(DIVINE_PAGE)
+      if (!isRub(divPage.unit) && !currencySwitchTried) {
+        currencySwitchTried = true
+        await switchCurrencyToRub(divPage.csrfToken)
+        divPage = await fetchPage(DIVINE_PAGE)
+      }
+      const chaosPage = await fetchPage(CHAOS_PAGE)
+      servers.value = pcServerNames(divPage.servers)
+
+      const override = widget.value?.funpayServer?.trim() || undefined
+      const server = findServer(divPage.servers, league.id, override)
+      if (!server) {
+        throw new Error(`FunPay: лига "${override ?? league.id}" не найдена. Укажите её вручную в настройках прайс-чека.`)
+      }
+
+      let divine = calcRate(divPage.lots, server.id)
+      const chaos = calcRate(chaosPage.lots,
+        chaosPage.servers.find(s => s.name === server.name)?.id ?? server.id)
+
+      // divine price missing -> derive from FunPay chaos page
+      const ninjaRate = xchgRate.value
+      if (divine == null && chaos != null && ninjaRate) divine = chaos * ninjaRate
+
+      rates.value = {
+        divine,
+        chaos,
+        unit: divPage.unit || '₽',
+        server: server.name,
+        updatedAt: Date.now()
+      }
+      error.value = null
+      lastUpdateTime = Date.now()
+    } catch (e) {
+      error.value = (e as Error).message
+      console.warn('[funpay]', error.value)
+    } finally {
+      isLoading.value = false
+    }
+  }
+
+  async function loadServers () {
+    if (serversLoading.value) return
+    serversLoading.value = true
+    try {
+      const page = await fetchPage(DIVINE_PAGE)
+      servers.value = pcServerNames(page.servers)
+    } catch (e) {
+      error.value = (e as Error).message
+    } finally {
+      serversLoading.value = false
+    }
+  }
+
+  function queueFetch () {
+    lastInterestTime = Date.now()
+    load()
+  }
+
+  /** how many Divine Orbs is 1 Mirror of Kalandra worth (poe.ninja) */
+  function divinesPerMirror (): number | undefined {
+    const divChaos = xchgRate.value
+    const mirror = findPriceByQuery({ ns: 'ITEM', name: 'Mirror of Kalandra', variant: undefined })
+    if (!divChaos || !mirror || !mirror.chaos) return undefined
+    return mirror.chaos / divChaos
+  }
+
+  /**
+   * Price of 1 Chaos Orb. FunPay chaos market is thin and noisy, so chaos is derived
+   * from the FunPay divine price and the in-game div/chaos ratio (poe.ninja).
+   * The FunPay chaos page is used only when poe.ninja rate is unavailable.
+   */
+  function chaosPrice (): number | undefined {
+    const r = rates.value
+    if (!r) return undefined
+    const ninjaRate = xchgRate.value
+    if (r.divine != null && ninjaRate) return r.divine / ninjaRate
+    return r.chaos
+  }
+
+  function convert (amount: number, currency: string): number | undefined {
+    if (!rates.value) return undefined
+    const { divine } = rates.value
+    const chaos = chaosPrice()
+    switch (currency) {
+      case 'divine': return divine != null ? amount * divine : undefined
+      case 'chaos': return chaos != null ? amount * chaos : undefined
+      case 'mirror': {
+        // mirror -> divines (poe.ninja) -> rubles (FunPay divine rate)
+        const perMirror = divinesPerMirror()
+        return (divine != null && perMirror != null) ? amount * perMirror * divine : undefined
+      }
+      default: return undefined
+    }
+  }
+
+  function openFunPay () {
+    window.open(FUNPAY_DIVINE_URL)
+  }
+
+  function format (value: number | undefined): string {
+    if (value == null || !Number.isFinite(value)) return ''
+    const unit = rates.value?.unit ?? '₽'
+    let num: string
+    if (value < 1) {
+      num = Number(value.toFixed(2)).toString()
+    } else if (value < 100) {
+      num = Number(value.toFixed(1)).toString()
+    } else {
+      num = Math.round(value).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ')
+    }
+    return `${num} ${unit}`
+  }
+
+  const tooltip = computed(() => {
+    const r = rates.value
+    if (!r) return error.value ?? 'FunPay…'
+    const parts = [`FunPay ${r.server}`]
+    if (r.divine != null) parts.push(`1 div = ${format(r.divine)}`)
+    const chaos = chaosPrice()
+    if (chaos != null) parts.push(`1 chaos = ${format(chaos)}`)
+    const perMirror = divinesPerMirror()
+    if (r.divine != null && perMirror != null) {
+      parts.push(`1 mirror = ${Math.round(perMirror)} div = ${format(perMirror * r.divine)}`)
+    }
+    return parts.join('\n')
+  })
+
+  setInterval(() => { load() }, RETRY_INTERVAL_MS)
+
+  watch(leagues.selectedId, () => {
+    rates.value = null
+    if (lastInterestTime) load(true)
+  })
+  watch(() => widget.value?.funpayServer, () => {
+    rates.value = null
+    error.value = null
+    lastAttemptTime = 0
+    if (lastInterestTime) load(true)
+  })
+
+  return {
+    enabled,
+    showColumn: computed(() => enabled.value && (rates.value != null || error.value != null)),
+    rates: readonly(rates),
+    error: readonly(error),
+    servers: readonly(servers),
+    serversLoading: readonly(serversLoading),
+    loadServers,
+    queueFetch,
+    convert,
+    openFunPay,
+    format,
+    tooltip
+  }
+})
+
+function pcServerNames (list: FunPayPage['servers']): string[] {
+  return list
+    .map(s => s.name)
+    .filter(name => /^\(PC\)/i.test(name))
+}
+
+function isRub (unit: string) {
+  return unit === '₽' || unit.toLowerCase().startsWith('руб')
+}
+
+async function fetchPage (url: string): Promise<FunPayPage> {
+  const response = await Host.proxy(url, {
+    headers: { 'accept-language': 'ru-RU,ru;q=0.9' }
+  })
+  if (!response.ok) throw new Error(`FunPay: HTTP ${response.status}`)
+  const html = await response.text()
+  const doc = new DOMParser().parseFromString(html, 'text/html')
+
+  let csrfToken: string | undefined
+  try {
+    const appData = JSON.parse(doc.body.getAttribute('data-app-data') ?? '{}')
+    csrfToken = appData['csrf-token']
+  } catch {}
+
+  const servers = Array.from(doc.querySelectorAll<HTMLOptionElement>('select[name="server"] option'))
+    .filter(opt => opt.value)
+    .map(opt => ({ id: opt.value, name: opt.textContent!.trim() }))
+
+  let unit = ''
+  const lots: FunPayLot[] = []
+  for (const row of Array.from(doc.querySelectorAll<HTMLElement>('a.tc-item'))) {
+    const priceEl = row.querySelector('.tc-price')
+    const unitEl = priceEl?.querySelector('.unit')
+    if (!priceEl) continue
+    if (!unit && unitEl) unit = unitEl.textContent!.trim()
+
+    const priceText = (priceEl.querySelector('div') ?? priceEl).childNodes[0]?.textContent ?? ''
+    const price = parseNumber(priceText)
+    const amount = parseNumber(row.querySelector('.tc-amount')?.textContent ?? '')
+    if (!Number.isFinite(price) || price <= 0) continue
+
+    lots.push({
+      serverId: row.dataset.server ?? '',
+      price,
+      amount: Number.isFinite(amount) ? amount : 0,
+      online: row.querySelector('.media-user.online') != null
+    })
+  }
+
+  return { unit, servers, lots, csrfToken }
+}
+
+async function switchCurrencyToRub (csrfToken: string | undefined) {
+  if (!csrfToken) return
+  const post = (confirmed: boolean) => Host.proxy('funpay.com/account/switchCurrency', {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/x-www-form-urlencoded; charset=UTF-8',
+      'x-requested-with': 'XMLHttpRequest',
+      accept: 'application/json, text/javascript, */*; q=0.01'
+    },
+    body: new URLSearchParams({ cy: 'rub', csrf_token: csrfToken, confirmed: String(confirmed) }).toString()
+  })
+  try {
+    const res = await post(false)
+    const data = await res.json().catch(() => ({})) as { modal?: string }
+    if (data.modal) {
+      await post(true)
+    }
+  } catch (e) {
+    console.warn('[funpay] currency switch failed', e)
+  }
+}
+
+function parseNumber (text: string): number {
+  const clean = text.replace(/[\s   ]/g, '').replace(',', '.')
+  const match = clean.match(/[\d.]+/)
+  return match ? Number(match[0]) : NaN
+}
+
+function calcRate (lots: FunPayLot[], serverId: string): number | undefined {
+  let pool = lots.filter(lot => lot.serverId === serverId)
+  if (!pool.length) return undefined
+
+  const online = pool.filter(lot => lot.online)
+  if (online.length >= MIN_ONLINE_LOTS) pool = online
+
+  const prices = pool
+    .map(lot => lot.price)
+    .sort((a, b) => a - b)
+    .slice(0, CHEAPEST_LOTS)
+
+  const mid = Math.floor(prices.length / 2)
+  return (prices.length % 2)
+    ? prices[mid]
+    : (prices[mid - 1] + prices[mid]) / 2
+}
+
+function normalize (name: string) {
+  return name.toLowerCase().replace(/\s+/g, ' ').trim()
+}
+
+/**
+ * Maps trade league id to FunPay server name:
+ *   "Standard"                       -> "(PC) Standard"
+ *   "Hardcore"                       -> "(PC) Hardcore"
+ *   "Curse of the Allflame"          -> "(PC) Curse of the Allflame"
+ *   "Hardcore Curse of the Allflame" -> "(PC) Curse of the Allflame [Hardcore]"
+ */
+export function leagueToFunPayName (leagueId: string): string {
+  const hc = /\b(Hardcore|HC)\b/i.test(leagueId)
+  const ruthless = /\bRuthless\b/i.test(leagueId)
+  const base = leagueId.replace(/\b(Hardcore|HC|Ruthless|SSF)\b/gi, '').replace(/\s+/g, ' ').trim()
+
+  if (!base || /^standard$/i.test(base)) {
+    const parts: string[] = []
+    if (ruthless) parts.push('Ruthless')
+    if (hc) parts.push('Hardcore')
+    return `(PC) ${parts.length ? parts.join(' ') : 'Standard'}`
+  }
+
+  const suffix = (ruthless && hc)
+    ? ' [Ruthless Hardcore]'
+    : hc ? ' [Hardcore]' : ruthless ? ' [Ruthless]' : ''
+  return `(PC) ${base}${suffix}`
+}
+
+interface ParsedServer {
+  pc: boolean
+  base: string
+  hc: boolean
+  ruthless: boolean
+}
+
+function parseLeagueName (name: string): ParsedServer {
+  const pc = /^\(PC\)/i.test(name)
+  const clean = name.replace(/^\([^)]*\)\s*/, '')
+  const hc = /\b(Hardcore|HC)\b/i.test(clean)
+  const ruthless = /\bRuthless\b/i.test(clean)
+  const base = normalize(clean
+    .replace(/\[[^\]]*\]/g, '')
+    .replace(/\b(Hardcore|HC|Ruthless|SSF)\b/gi, ''))
+  return { pc, base, hc, ruthless }
+}
+
+function findServer (servers: FunPayPage['servers'], leagueId: string, override?: string) {
+  if (override) {
+    const needle = normalize(override)
+    return servers.find(s => normalize(s.name) === needle) ??
+      servers.find(s => normalize(s.name).includes(needle))
+  }
+
+  // 1. exact match, e.g. "Hardcore Curse of the Allflame" -> "(PC) Curse of the Allflame [Hardcore]"
+  const target = normalize(leagueToFunPayName(leagueId))
+  const exact = servers.find(s => normalize(s.name) === target)
+  if (exact) return exact
+
+  // 2. fuzzy match, e.g. trade league "Allflame" -> "(PC) Curse of the Allflame"
+  const league = parseLeagueName(leagueId)
+  const isPermanent = !league.base || league.base === 'standard'
+  const candidates = servers.filter(s => {
+    const fp = parseLeagueName(s.name)
+    if (!fp.pc || fp.hc !== league.hc || fp.ruthless !== league.ruthless) return false
+    if (isPermanent) return !fp.base || fp.base === 'standard'
+    return fp.base.length > 0 && (fp.base.includes(league.base) || league.base.includes(fp.base))
+  })
+  // prefer the shortest name (closest match)
+  return candidates.sort((a, b) => a.name.length - b.name.length)[0]
+}
